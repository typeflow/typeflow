{
  "name": "typeflowjs",
  "version": "0.0.1",
  "description": "Typed JSON transformations, checked at compile time. Declarative .typeflow mapping files with TypeScript-native typing.",
  "keywords": [
    "dsl",
    "jq",
    "json",
    "jsonata",
    "mapping",
    "pathx",
    "transformation",
    "typed",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/typeflow/typeflow"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "imports": {
    "#core": "./src/core/index.ts",
    "#compiler": "./src/compiler/index.ts",
    "#builtins": "./src/builtins/index.ts",
    "#builtins/values": "./src/builtins/values.ts",
    "#parser": "./src/parser/index.ts",
    "#runtime": "./src/runtime/index.ts",
    "#adapter": "./src/adapter/index.ts",
    "#formatter": "./src/formatter/index.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/types/runtime/index.d.ts",
      "bun": "./src/runtime/index.ts",
      "import": "./dist/runtime/index.js",
      "require": "./dist/runtime/index.cjs",
      "default": "./dist/runtime/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "postinstall": "bun scripts/link-local-deps.ts",
    "typeflow": "bun apps/cli/src/main.ts",
    "build": "bun scripts/build.ts && bun run --cwd apps/cli build",
    "typecheck": "bun apps/cli/src/main.ts types \"examples/**/*.typeflow\" && tsc --noEmit",
    "check:examples": "bun apps/cli/src/main.ts check \"examples/**/*.typeflow\"",
    "demo": "bun examples/api-response/demo.ts",
    "test": "bun test",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "bun run build && bun run lint && bun run format:check && bun test",
    "bench": "bun apps/benchmarks/run.ts",
    "bench:publish": "bun apps/benchmarks/publish.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0 <7.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
