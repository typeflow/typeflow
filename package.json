{
  "name": "@thomasfarineau/typeflow",
  "version": "0.0.1",
  "description": "Typed JSON transformations, checked at compile time. Declarative .typeflow mapping files with TypeScript-native typing.",
  "keywords": [
    "dsl",
    "jq",
    "json",
    "jsonata",
    "mapping",
    "pathx",
    "transformation",
    "typed",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfarineau/typeflow"
  },
  "bin": {
    "typeflow": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/types/runtime/index.d.ts",
      "bun": "./src/runtime/index.ts",
      "import": "./dist/runtime/index.js",
      "require": "./dist/runtime/index.cjs",
      "default": "./dist/runtime/index.js"
    },
    "./converter": {
      "types": "./dist/types/converter/index.d.ts",
      "bun": "./src/converter/index.ts",
      "import": "./dist/converter/index.js",
      "require": "./dist/converter/index.cjs",
      "default": "./dist/converter/index.js"
    },
    "./converter/jsonata": {
      "types": "./dist/types/converter/jsonata/index.d.ts",
      "bun": "./src/converter/jsonata/index.ts",
      "import": "./dist/converter/jsonata/index.js",
      "require": "./dist/converter/jsonata/index.cjs",
      "default": "./dist/converter/jsonata/index.js"
    },
    "./converter/jq": {
      "types": "./dist/types/converter/jq/index.d.ts",
      "bun": "./src/converter/jq/index.ts",
      "import": "./dist/converter/jq/index.js",
      "require": "./dist/converter/jq/index.cjs",
      "default": "./dist/converter/jq/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typeflow": "bun src/cli/main.ts",
    "build": "bun scripts/build.ts",
    "typecheck": "bun src/cli/main.ts types \"examples/**/*.typeflow\" && tsc --noEmit",
    "check:examples": "bun src/cli/main.ts check \"examples/**/*.typeflow\"",
    "demo": "bun examples/api-response/demo.ts",
    "docs:dev": "bun scripts/generate-docs.ts && bun scripts/bench/publish.ts && vitepress dev docs",
    "docs:build": "bun scripts/generate-docs.ts && bun scripts/bench/publish.ts && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "bun test",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "bun run build && bun run lint && bun run format:check && bun test",
    "docs:gen": "bun scripts/generate-docs.ts",
    "bench": "bun scripts/bench/run.ts",
    "bench:publish": "bun scripts/bench/publish.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/markdown-it-container": "^4.0.0",
    "@types/node": "^24.0.0",
    "jq-wasm": "^3.0.0-jq-1.8.2",
    "jsonata": "^2.2.1",
    "markdown-it-container": "^4.0.0",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
