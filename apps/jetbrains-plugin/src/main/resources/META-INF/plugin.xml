<idea-plugin>
    <id>fr.thomasfarineau.typeflow.idea</id>
    <name>Typeflow</name>
    <vendor url="https://github.com/thomasfarineau/typeflow">Thomas Farineau</vendor>
    <description><![CDATA[
        Syntax highlighting and inline diagnostics for <code>.typeflow</code> mapping files.
        <p>Diagnostics run the <code>typeflow</code> CLI (<code>typeflow check --json</code>) from
        your project — install <code>@thomasfarineau/typeflow</code> and make sure the
        <code>typeflow</code> binary is resolvable (a local <code>node_modules/.bin</code>, a global
        install, or a shim for <code>npx</code>/<code>bunx typeflow</code>).</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
            name="Typeflow"
            implementationClass="fr.thomasfarineau.typeflow.idea.TypeflowFileType"
            fieldName="INSTANCE"
            language="Typeflow"
            extensions="typeflow"/>
        <lang.syntaxHighlighterFactory
            language="Typeflow"
            implementationClass="fr.thomasfarineau.typeflow.idea.TypeflowSyntaxHighlighterFactory"/>
        <colorSettingsPage implementation="fr.thomasfarineau.typeflow.idea.TypeflowColorSettingsPage"/>
        <externalAnnotator
            language="Typeflow"
            implementationClass="fr.thomasfarineau.typeflow.idea.TypeflowExternalAnnotator"/>
        <completion.contributor
            language="Typeflow"
            implementationClass="fr.thomasfarineau.typeflow.idea.TypeflowCompletionContributor"/>
    </extensions>
</idea-plugin>
