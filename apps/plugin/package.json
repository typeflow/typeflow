{
  "name": "@typeflow/plugin",
  "version": "0.0.1",
  "description": "Import .typeflow mapping files directly — Node ESM loader, CommonJS require hook, and Bun plugin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfarineau/typeflow"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./register": "./dist/register.js",
    "./loader": "./dist/loader.js",
    "./bun": "./dist/bun.js",
    "./vite": "./dist/vite.js"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun scripts/build.ts && bun scripts/smoke.ts"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "tsx": "^4.23.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=20.6"
  }
}
