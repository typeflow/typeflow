{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "allowArbitraryExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@thomasfarineau/typeflow-core": ["./packages/core/src/index.ts"],
      "@thomasfarineau/typeflow-parser": ["./packages/parser/src/index.ts"],
      "@thomasfarineau/typeflow-compiler": ["./packages/compiler/src/index.ts"],
      "@thomasfarineau/typeflow-runtime": ["./packages/runtime/src/index.ts"],
      "@thomasfarineau/typeflow-adapter-typescript": ["./packages/adapter-typescript/src/index.ts"],
      "@thomasfarineau/typeflow-formatter": ["./packages/formatter/src/index.ts"],
      "@thomasfarineau/typeflow-cli": ["./packages/cli/src/index.ts"],
      "@thomasfarineau/typeflow-bun-plugin": ["./packages/bun-plugin/src/index.ts"],
      "@thomasfarineau/typeflow": ["./packages/typeflow/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/test/**/*.ts", "examples/**/*.ts"]
}
